<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="64dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Header: Timestamp & Sender -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_light"
            android:textSize="11sp"
            tools:text="16:02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/chat__sender_you"
            android:textColor="@color/text_light"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Outgoing Image Bubble: Dark Navy Frame -->
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        card_view:cardBackgroundColor="@color/background_own_message"
        card_view:cardCornerRadius="16dp"
        card_view:cardElevation="0dp"
        card_view:cardPreventCornerOverlap="false">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp">

            <TextView
                android:id="@+id/tv_missing_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_chat_input_background"
                android:padding="12dp"
                android:textColor="@color/text_own_message"
                android:textSize="13sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_image"
                android:layout_width="220dp"
                android:layout_height="180dp"
                android:contentDescription="@string/chat__cd__sent_image"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/backgrounds/scenic" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Outgoing Transmission Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/chat__mesh_status_own"
        android:textColor="@color/status_delivered"
        android:textSize="11sp" />

</LinearLayout>

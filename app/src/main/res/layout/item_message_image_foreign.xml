<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="64dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Header: Sender Badge & Timestamp -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_pill_badge_gray"
            android:fontFamily="sans-serif-black"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="NODE"
            android:textColor="@color/text_dark"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_light"
            android:textSize="11sp"
            tools:text="16:03" />
    </LinearLayout>

    <!-- Incoming Image Bubble: Bordered Frame -->
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        card_view:cardBackgroundColor="@color/background_foreign_message"
        card_view:cardCornerRadius="16dp"
        card_view:cardElevation="0dp"
        card_view:cardPreventCornerOverlap="false">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_incoming_bubble"
            android:padding="4dp">

            <TextView
                android:id="@+id/tv_missing_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_chat_input_background"
                android:padding="12dp"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_image"
                android:layout_width="220dp"
                android:layout_height="180dp"
                android:contentDescription="@string/chat__cd__received_image"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/backgrounds/scenic" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Incoming Transmission Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/chat__mesh_status_foreign"
        android:textColor="@color/status_delivered"
        android:textSize="11sp" />

</LinearLayout>
